function checkOnline(phoneNumber)
	for k, v in ipairs(getElementsByType("player")) do
		if v and tonumber(phoneNumber) and exports.san_items:hasItemS(v, 16, phoneNumber) then
	
			return v
		end
	end
	return false
end

