allVehicleName = {
	--pl.
	--[ID] = "Rendes név",
	--[400] = "BMW 750", 
}

function getVehicleRealName(vehicleid)
	if allVehicleName[vehicleid] then
		return allVehicleName[vehicleid]
	else 
		return getVehicleNameFromModel(vehicleid)
	end 
end





