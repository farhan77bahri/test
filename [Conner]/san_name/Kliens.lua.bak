local x, y = guiGetScreenSize()


local settings = {}
settings.font = dxCreateFont("files/roboto.ttf", 20)
settings.maxdis = 20 -- max távolság
settings.anames = false

local levelNames = {
	"#00ff00(Trial_Helper)", --1
	"#00ff00(Helper)",       --2
	"#00ff00(Head_Helper)",  --3
	"#ffff00(Trial-Admin)",  --4
	
	"#ffff00(ADMIN I)",      --6
	"#ffff00(ADMIN II)",      --7 
	"#ffff00(ADMIN III)",    --8
	"#0c94fd(Senior_Admin)",  --9
	"#4b0082(Supervisor)",    --10
	"#191970(Head_Admin)",   --11
	"#696969(Management)",   --12
	"#8A2BE2(Manager)",      --13
	"#ff0000(Owner)",       --14
	"#ff0000(Funder)",      --15
    "#8A2BE2(funiiiii)",    --16
	
}
levelNames[0] = ""

function clamp(val, lower, upper)
    if (lower > upper) then lower, upper = upper, lower end
    return math.max(lower, math.min(upper, val))
end


local helperNames = {"#C71585", "#C71585(Colaborador)"}
helperNames[0] = ""

function getAdminLevelName(player)
	if getElementData(player, "char:adminduty") == 0 then return "" end
	return levelNames[getElementData(player, "acc:admin")]
end

function getHelperLevelName(player)
	return helperNames[getElementData(player, "acc:aseged")]
end


