function markPlayer(thePlayer, x, y, z)
	if not isElement(client) or not isElement(thePlayer) then return end
    local clientname = getPlayerName(client)
    local name = getPlayerName(thePlayer)

	triggerClientEvent(client,"markPlayer",resourceRoot,thePlayer,x, y, z)
end
addEvent("markPlayer",true)
addEventHandler("markPlayer",root,markPlayer)














function KickAllPlayer (player)
	local account = getAccountName ( getPlayerAccount ( player ) )
if ( isObjectInACLGroup ( "user." .. account, aclGetGroup ( "Console" ) ) ) then
	for k,v in ipairs(getElementsByType("player")) do
		if v ~= player then
			kickPlayer(v, "Console", "MANUTENÇÃO" )
			setGameType("MANUTENÇÃO")
			setServerPassword( abinis159753 )
		end
	end
end
end
addCommandHandler("kickall", KickAllPlayer)

