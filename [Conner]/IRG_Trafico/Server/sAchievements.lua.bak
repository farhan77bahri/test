function contagemVehicleC (thePlayer, theTruck)
if not thePlayer then return end
     if getElementType(theTruck) == "vehicle" then 
         if exports['san_items']:hasItemS(theTruck, 14) then 
         	 exports['san_items']:giveItem(theTruck, 14, 1, contagemCV[thePlayer], 0, false)
             timerContC[thePlayer] = setTimer(function (thePlayer, theTruck)
    		 setElementFrozen(theTruck, true)
             triggerEvent('btcMTA->#takePlayerItemToID', thePlayer, theTruck, 14, false)
    		 contagemCV[thePlayer] = contagemCV[thePlayer] + 1
    		 end, contagemCV[thePlayer]*1000, 1, thePlayer)
		 end
	 end
end

function finishServiceC (thePlayer, theTruck) 
if not thePlayer then return end
if not getElementData(thePlayer, "loggedin") then return end
     if getElementType(theTruck) == "vehicle" then 
     	 if not exports['san_items']:hasItemS(theTruck, 14) then 
    		 exports.san_hud:dm("Descarregamento finalizado com sucesso.",thePlayer, 255, 255, 255)
    		 exports.san_hud:dm("Valor descarregado "..contagemCV[thePlayer]..".",thePlayer, 255, 255, 255)
     		 setElementFrozen(theTruck, false)
     		 Merca[thePlayer] = "COCAINA"
    		 buyCarga (thePlayer, theTruck)
     		 setElementData(thePlayer, "venderDrogas", false)
			 setElementData(thePlayer, "infoContagem", false)
		 end
	 end
end

function buyCarga (thePlayer, theTruck)
if not thePlayer then return end
     if (Merca[thePlayer] == "MACONHA") then
	 
         local MHcoc = dbQuery(db, "SELECT * FROM BOLSA WHERE DROGA_NAME=?", "MACONHA")
         local BresultM = dbPoll(MHcoc, -1)  

         local hoc = dbQuery(db, "SELECT * FROM UND WHERE NDROGA=?", "MACONHA")
         local resultM = dbPoll(hoc, -1)  
         if #resultM ~= 0 then
		 
			     if (resultM[1]["UNIDADE"] > resultM[1]["MAX"]) then
				     if (BresultM[1]["VALOR"] > 400) then
					 else
					 end
				 end		 
		     if (resultM[1]["UNIDADE"] < resultM[1]["MAX"]) then
		         dbExec(db, "UPDATE UND SET UNIDADE=? WHERE NDROGA=?", resultM[1]["UNIDADE"] + contagemMV[thePlayer], "MACONHA")
				 outputDebugString("*[BOLSA TRAFICO] Load: Unidade da "..(resultM[1]["NDROGA"]).." é de: "..(resultM[1]["UNIDADE"])..".")
				 else
				 dbExec(db, "UPDATE UND SET UNIDADE=? WHERE NDROGA=?", 1, "MACONHA")
				 outputDebugString("*[BOLSA TRAFICO] Load: Unidade da "..(resultM[1]["NDROGA"]).." foi zerado com sucesso.")
				 outputDebugString("*[BOLSA TRAFICO] Load: Unidade da "..(resultM[1]["NDROGA"]).." é de: "..(resultM[1]["UNIDADE"])..".")
			 end
		     	 Value[thePlayer] = BresultM[1]["VALOR"] * contagemMV[thePlayer]
				 if not getElementData(thePlayer, "loggedin") then return end
		    	 setElementData(thePlayer, "char:moneysujo", (getElementData(thePlayer, "char:moneysujo") or 0) + Value[thePlayer])
		     else
			 dbFree(dbQuery(db, "INSERT INTO UND ( NDROGA, UNIDADE, MAX ) VALUES ( 'MACONHA', '0', '200')"))
			 dbExec(db, "UPDATE UND SET UNIDADE WHERE NDROGA=?", resultM[1]["UNIDADE"] + contagemMV[thePlayer], Merca[thePlayer])
			 Value[thePlayer] = BresultM[1]["VALOR"] * contagemMV[thePlayer]
			 setElementData(thePlayer, "char:moneysujo", (getElementData(thePlayer, "char:moneysujo") or 0) + Value[thePlayer])
         end		 
	 end
     if (Merca[thePlayer] == "HEROINA") then
	 
         local BHcoc = dbQuery(db, "SELECT * FROM BOLSA WHERE DROGA_NAME=?", "HEROINA")
         local BresultH = dbPoll(BHcoc, -1)  

         local hoc = dbQuery(db, "SELECT * FROM UND WHERE NDROGA=?", "HEROINA")
         local resultH = dbPoll(hoc, -1)  
         if #resultH ~= 0 then
		 
			     if (resultH[1]["UNIDADE"] > resultH[1]["MAX"]) then
				     if (BresultH[1]["VALOR"] > 400) then
					 else
					 end
				 end		 
		     if (resultH[1]["UNIDADE"] < resultH[1]["MAX"]) then
		         dbExec(db, "UPDATE UND SET UNIDADE=? WHERE NDROGA=?", resultH[1]["UNIDADE"] + contagemHV[thePlayer], Merca[thePlayer])
				 outputDebugString("*[BOLSA TRAFICO] Load: Unidade da "..(resultH[1]["NDROGA"]).." é de: "..(resultH[1]["UNIDADE"])..".")
				 else
				 dbExec(db, "UPDATE UND SET UNIDADE=? WHERE NDROGA=?", 1, "HEROINA")
				 outputDebugString("*[BOLSA TRAFICO] Load: Unidade da "..(resultH[1]["NDROGA"]).." foi zerado com sucesso.")
				 outputDebugString("*[BOLSA TRAFICO] Load: Unidade da "..(resultH[1]["NDROGA"]).." é de: "..(resultH[1]["UNIDADE"])..".")
			 end
		     	 Value[thePlayer] = BresultH[1]["VALOR"] * contagemHV[thePlayer]
				 if not getElementData(thePlayer, "loggedin") then return end
		    	 setElementData(thePlayer, "char:moneysujo", (getElementData(thePlayer, "char:moneysujo") or 0) + Value[thePlayer])
		     else
			 dbFree(dbQuery(db, "INSERT INTO UND ( NDROGA, UNIDADE, MAX ) VALUES ( 'HEROINA', '0', '200')"))
			 dbExec(db, "UPDATE UND SET UNIDADE WHERE NDROGA=?", resultH[1]["UNIDADE"] + contagemHV[thePlayer], Merca[thePlayer])
			 Value[thePlayer] = BresultH[1]["VALOR"] * contagemHV[thePlayer]
			 setElementData(thePlayer, "char:moneysujo", (getElementData(thePlayer, "char:moneysujo") or 0) + Value[thePlayer])
         end		 
	 end
     if (Merca[thePlayer] == "COCAINA") then
	 
         local Bcoc = dbQuery(db, "SELECT * FROM BOLSA WHERE DROGA_NAME=?", "COCAINA")
         local BresultC = dbPoll(Bcoc, -1)  

         local coc = dbQuery(db, "SELECT * FROM UND WHERE NDROGA=?", "COCAINA")
         local resultC = dbPoll(coc, -1)  
         if #resultC ~= 0 then
		 
			     if (resultC[1]["UNIDADE"] > resultC[1]["MAX"]) then
				     if (BresultC[1]["VALOR"] > 400) then
					 else
					 end
				 end		 
		     if (resultC[1]["UNIDADE"] < resultC[1]["MAX"]) then
		         dbExec(db, "UPDATE UND SET UNIDADE=? WHERE NDROGA=?", resultC[1]["UNIDADE"] + contagemCV[thePlayer], Merca[thePlayer])
				 outputDebugString("*[BOLSA TRAFICO] Load: Unidade da "..(resultC[1]["NDROGA"]).." é de: "..(resultC[1]["UNIDADE"])..".")
				 else
				 dbExec(db, "UPDATE UND SET UNIDADE=? WHERE NDROGA=?", 1, "COCAINA")
				 outputDebugString("*[BOLSA TRAFICO] Load: Unidade da "..(resultC[1]["NDROGA"]).." foi zerado com sucesso.")
				 outputDebugString("*[BOLSA TRAFICO] Load: Unidade da "..(resultC[1]["NDROGA"]).." é de: "..(resultC[1]["UNIDADE"])..".")
			 end
		     	 Value[thePlayer] = BresultC[1]["VALOR"] * contagemCV[thePlayer]
				 if not getElementData(thePlayer, "loggedin") then return end
		    	     setElementData(thePlayer, "char:moneysujo", (getElementData(thePlayer, "char:moneysujo") or 0) + Value[thePlayer])
		     else
			 dbFree(dbQuery(db, "INSERT INTO UND ( NDROGA, UNIDADE, MAX ) VALUES ( 'COCAINA', '0', '200')"))
			 dbExec(db, "UPDATE UND SET UNIDADE WHERE NDROGA=?", resultC[1]["UNIDADE"] + contagemCV[thePlayer], Merca[thePlayer])
			 Value[thePlayer] = BresultC[1]["VALOR"] * contagemCV[thePlayer]
			 setElementData(thePlayer, "char:moneysujo", (getElementData(thePlayer, "char:moneysujo") or 0) + Value[thePlayer])
         end		 
	 end
end

function attb (thePlayer, command, element)
     if (element == "bolsa") then
	     if getElementData(thePlayer, "acc:admin") > 7 then
		     outputChatBox("#7cc576[BOLSA DE VALORES] Você alterou a bolsa de valores com sucesso.", thePlayer, 255,255,255, true)	
			 randomList ()
		 end
	 end
end
addCommandHandler("att", attb)

