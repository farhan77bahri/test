function rebaixar (RID)
     local newPR = dbQuery(db, "SELECT * FROM BOLSA WHERE ID=?", RID)
     local NewRB = dbPoll(newPR, -1) 
	 if #NewRB ~= 0 then
         dbExec(db, "UPDATE BOLSA SET VALOR=? WHERE DROGA_NAME=?", 100, NewRB[1]["DROGA_NAME"])
		 outputDebugString("*[BOLSA TRAFICO] Load: "..(NewRB[1]["DROGA_NAME"]).." Foi rebaixado.")
		-- setTimer(randomDroga, 5000, 1, RID) 
		 attBolsa (NewRB[1]["DROGA_NAME"], "#FF0000-300")
	 end 
end

function randomList (ID)
    local newP = dbQuery(db, "SELECT * FROM BOLSA WHERE VALOR=?", 100)
     local NewPos = dbPoll(newP, -1) 
	 if #NewPos ~= 0 then
		 if (NewPos[1]["VALOR"] == 100) then
		     if (NewPos[1]["ID"] == ID) then
			     setTimer(rebaixar, 5000, 1, ID)
				 randomListCenter(ID)
				 outputDebugString("*[BOLSA TRAFICO] Load: "..(NewPos[1]["DROGA_NAME"]).." Foi para list center.")
			 else
			     dbExec(db, "UPDATE BOLSA SET VALOR=? WHERE DROGA_NAME=?", 350, NewPos[1]["DROGA_NAME"])
			     attBolsa (NewPos[1]["DROGA_NAME"], "#00FF00+300")
			     outputDebugString("*[BOLSA TRAFICO] Load: "..(NewPos[1]["DROGA_NAME"]).." Foi colocada no centro da lista.")
				 selectTop (ID, NewPos[1]["ID"])
			     setTimer(rebaixar, 5000, 1, ID)
			 end
		 end
	 end
end

function randomListCenter (BID)
     if (BID) then
	     center = math.random(1, 3)
		 if (center) then
			 if center == BID then randomListCenter (BID) return end
			--else
             local newC = dbQuery(db, "SELECT * FROM BOLSA WHERE ID=?", center)
             local NewPosCenter = dbPoll(newC, -1) 
              	 if #NewPosCenter ~= 0 then
			         dbExec(db, "UPDATE BOLSA SET VALOR=? WHERE DROGA_NAME=?", 350, NewPosCenter[1]["DROGA_NAME"])
			         attBolsa (NewPosCenter[1]["DROGA_NAME"], "#00FF00+300")
			         outputDebugString("*[BOLSA TRAFICO] Load: "..(NewPosCenter[1]["DROGA_NAME"]).." Foi colocada no centro da lista.")	
                     selectTop (BID, NewPosCenter[1]["ID"])	 
                -- end				 
			 end			 
		 end
	 end
end
 
function selectTop (BLOCKID, BLOCKID2)
     if BLOCKID then
	     if BLOCKID2 then
		     top = math.random(1, 3)
			 if (top) then
			     if (top == BLOCKID) then selectTop (BLOCKID, BLOCKID2) return else
				     if (top == BLOCKID2) then selectTop (BLOCKID, BLOCKID2) return else
                     local newT = dbQuery(db, "SELECT * FROM BOLSA WHERE ID=?", top)
                     local NewPosTop = dbPoll(newT, -1) 
  					     if #NewPosTop ~= 0 then
	     		             dbExec(db, "UPDATE BOLSA SET VALOR=? WHERE DROGA_NAME=?", 700, NewPosTop[1]["DROGA_NAME"])
		    	             attBolsa (NewPosTop[1]["DROGA_NAME"], "#00FF00+300")
			                 outputDebugString("*[BOLSA TRAFICO] Load: "..(NewPosTop[1]["DROGA_NAME"]).." Foi colocada no topo da lista.")	
                             outputChatBox("#7cc576[BOLSA DE VALORES] O valor da #FFFFFF"..(NewPosTop[1]["DROGA_NAME"]).." #7cc576Foi editado para #FFFFFF1000#7cc576 Reais", root, 255,255,255, true)							 
                         end							 
					 end
				 end
			 end
		 end
	 end
end 
 
function randomDroga (ID) 
     if ID then
	     newTop = math.random(1, 3)
         local newT = dbQuery(db, "SELECT * FROM BOLSA WHERE ID=?", newTop)
         local New = dbPoll(newT, -1) 
		     if #New ~= 0 then
			     if (New[1]["VALOR"] == 700) then randomDroga (ID) return end 
			         if (New[1]["VALOR"] ~= 100) then
					     if (New[1]["ID"] ~= ID) then
	     	                 outputChatBox("#7cc576[BOLSA DE VALORES] O valor da #FFFFFF"..(New[1]["DROGA_NAME"]).." #7cc576Foi editado para #FFFFFF1000#7cc576 Reais", root, 255,255,255, true)
	         	     		 dbExec(db, "UPDATE BOLSA SET VALOR=? WHERE ID=?", 700, newTop)
	         	    		 attBolsa (New[1]["DROGA_NAME"], "#00FF00+700")
				     		 randomList ()
					     else
				     randomDroga (ID)
				 end
		     end
         end
	 end
end
--]]

timer = {}
bolsa = {}

function painel(thePlayer)
if not thePlayer then return end
     if not bolsa[thePlayer] then
	     bolsa[thePlayer] = false
	 end
	     if bolsa[thePlayer] == false then
	         if isTimer(timer[thePlayer]) then
			     exports.san_infobox:addNotification(thePlayer,"Aguarde 5 segundos para abrir o painel novamente","error")
	     	 return end
        	 timer[thePlayer] = setTimer(function() end, 5000, 1)
             attBolsa("MACONHA", 1)
         	 attBolsa("HEROINA", 1)
        	 attBolsa("COCAINA", 1)
             attBolsa("MAÇA", 2)
         	 attBolsa("MADEIRA", 2)
        	 attBolsa("LARANJA", 2)
         	 triggerClientEvent(thePlayer, "startDxB", thePlayer)
	     	 bolsa[thePlayer] = true
			 exports.san_admin:outputAdminMessage(" "..getPlayerName(thePlayer).." ID: #7cc576(" .. getElementData(thePlayer, "playerid")..") Abriu o painel de bolsa de valores.")
	      else
	         bolsa[thePlayer] = false
			 triggerClientEvent(thePlayer, "startDxB", thePlayer)
	 end
end

function restart()
	for index, player in ipairs(getElementsByType("player")) do
	bindKey(player, "F4", "down", painel)
	end
end
addEventHandler("onResourceStart", getResourceRootElement(getThisResource()), restart)

function entrar()
	bindKey(source, "F4", "down", painel)
end
addEventHandler("onPlayerJoin", getRootElement(), entrar)

function fechar(player)
	for index, player in ipairs(getElementsByType("player")) do
	unbindKey(player, "F4", "down", painel)
	end
end
addEventHandler("onResourceStop", getResourceRootElement(getThisResource()), fechar)

addEventHandler("onPlayerQuit", root,
function ()
     if isTimer(contagemTimer[source]) then
		 killTimer(contagemTimer[source])
     end
end)



local originalGetPlayerCount = getPlayerCount
function getPlayerCount()
    return originalGetPlayerCount and originalGetPlayerCount() or #getElementsByType("player")
end