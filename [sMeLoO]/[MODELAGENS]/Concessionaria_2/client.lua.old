txd = engineLoadTXD ( "concecar.txd" ) --Coloque o nome do TXD
engineImportTXD ( txd, 4028 ) --Coloque o ID do objeto que você quer modificar
col = engineLoadCOL ( "concecar.col" ) --Coloque o nome do arquivo COL
engineReplaceCOL ( col, 4028 ) --Coloque o ID do objeto que você quer modificar
dff = engineLoadDFF ( "concecar.dff", 0 ) --Coloque o nome do DFF e não mexa nesse 0
engineReplaceModel ( dff, 4028 ) --Coloque o ID do objeto que você quer modificar
engineSetModelLODDistance(4028, 500) --ID do objeto e a distância que ele irá carregar - distancia está como 500
