	 end
	 if hours == 15 then
	     setElementData(source, "temp:char", "33°")
	 end
	 if hours == 16 then
	     setElementData(source, "temp:char", "33°")
	 end
	 if hours == 17 then
	     setElementData(source, "temp:char", "28°")
	 end
