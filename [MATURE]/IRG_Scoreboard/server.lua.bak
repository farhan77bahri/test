	     setElementData(source, "temp:char", "19°")
	 end
	 if hours == 24 then
	     setElementData(source, "temp:char", "18°")
     end
	 local playerAccount = getPlayerAccount(source)
	 if (getAccountData(playerAccount, "setIMG")) then
	     setElementData(source, "setIMG", getAccountData(playerAccount, "setIMG"))
	 end
  end
)

function onPlayerQuit()
      local playerAccount = getPlayerAccount(source) -- get his account
      if (playerAccount) then -- if we got the account then
            setAccountData(playerAccount, "setIMG", getElementData(source, "setIMG")) -- store his current money amount in his account data
      end
end
addEventHandler("onPlayerQuit", getRootElement(), onPlayerQuit)

