addEventHandler("onPlayerLogin", root,
  function()
	 local time = getRealTime()
	 local hours = time.hour
	 if hours == 1 then
	     setElementData(source, "temp:char", "16°")
	 end
	 if hours == 2 then
	     setElementData(source, "temp:char", "14°")
	 end
	 if hours == 3 then
	     setElementData(source, "temp:char", "13°")
	 end
	 if hours == 4 then
	     setElementData(source, "temp:char", "10°")
	 end
	 if hours == 5 then
	     setElementData(source, "temp:char", "4°°")
	 end
	 if hours == 6 then
	     setElementData(source, "temp:char", "- 1°")
	 end
