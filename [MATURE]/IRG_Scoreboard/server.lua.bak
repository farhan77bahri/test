function togValaszolasok(thePlayer, commandName)
	
		local allapot = getElementData(thePlayer, "hud")
		
		if allapot == false then
			--outputChatBox("Você desligou a #7cc576hud#ffffff", thePlayer, 255, 255, 255, true)
			setElementData(thePlayer, "hud", true)
			showChat(false)
		else
			--outputChatBox("Você ligou a #7cc576hud", thePlayer, 255, 255, 255, true)
			setElementData(thePlayer, "hud", false)
			showChat(true)
	end
end
addCommandHandler("hud", togValaszolasok, false, false)