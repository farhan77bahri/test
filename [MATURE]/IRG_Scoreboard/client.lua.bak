addEventHandler("onClientRender", root,
	function()
		
		
	--if getChatboxLayout() then return end
	 if selectIMG then
	 if not isCursorShowing() then selectIMG = false return end
	 if (getElementData(localPlayer, "TabActive")) then selectIMG = false end
        dxDrawRectangle(screenW * 0.3500, screenH * 0.3870, screenW * 0.2552, screenH * 0.2037, tocolor(1, 0, 0, 142), false)
        dxDrawRectangle(screenW * 0.3500, screenH * 0.3870, screenW * 0.2578, screenH * 0.0278, tocolor(1, 0, 0, 142), false)
        dxDrawText("MENU IMAGENS - IRAN GAMING", screenW * 0.3500, screenH * 0.3870, screenW * 0.6078, screenH * 0.4167, tocolor(255, 254, 254, 131), x*0.80, "default-bold", "center", "center", false, false, false, false, false)
	     if myIMG > 1 then
		 cor[1]  = tocolor(255,255,255,100)
 		 if isCursorOnElement(screenW * 0.3552, screenH * 0.4509, screenW * 0.0786, screenH * 0.0796) then cor[1] = tocolor(255,255,255, 215) end
		     dxDrawImage(screenW * 0.3552, screenH * 0.4509, screenW * 0.0786, screenH * 0.0796, "files/0"..(myIMG - 1)..".png", 0, 0, 0, tocolor(255,255,255, 120), false)
			 dxDrawText("<", screenW * 0.3552, screenH * 0.4444, screenW * 0.4307, screenH * 0.5463, cor[1], x*2.00, "pricedown", "center", "center", false, false, false, false, false)
		 end
		 if myIMG < 5 then
		 cor[2]  = tocolor(255,255,255,100)
 		 if isCursorOnElement(screenW * 0.5240, screenH * 0.4509, screenW * 0.0786, screenH * 0.0796) then cor[2] = tocolor(255,255,255, 215) end
		     dxDrawImage(screenW * 0.5240, screenH * 0.4509, screenW * 0.0786, screenH * 0.0796, "files/0"..(myIMG + 1)..".png", 0, 0, 0, tocolor(255,255,255, 120), false)
			 dxDrawText(">", screenW * 0.5271, screenH * 0.4444, screenW * 0.6026, screenH * 0.5463, cor[2], x*2.00, "pricedown", "center", "center", false, false, false, false, false)
		 end
		 if myIMG > 0 then
		     dxDrawImage(screenW * 0.4255, screenH * 0.4352, screenW * 0.1057, screenH * 0.1046, "files/0"..myIMG..".png", 0, 0, 0, tocolor(255, 255, 255, 240), false)
		 end
		 cor[3]  = tocolor(0, 0, 0,100)
 		 if isCursorOnElement(screenW * 0.4151, screenH * 0.5537, screenW * 0.1266, screenH * 0.0278) then cor[3] = tocolor(144,238,144, 215) end
        dxDrawRectangle(screenW * 0.4151, screenH * 0.5537, screenW * 0.1266, screenH * 0.0278, cor[3] , false)
        dxDrawText("APLICAR", screenW * 0.4151, screenH * 0.5556, screenW * 0.5417, screenH * 0.5824, tocolor(255, 255, 255, 255), x*0.80, "default-bold", "center", "center", false, false, false, false, false)
		end
    end
)

cor = {}



function selectC ( button,state,thePlayer )
	if not getElementData(localPlayer,"loggedin") then return end
     if (getElementData(localPlayer, "TabActive")) then
	-- if getChatboxLayout() then return end
          if  state == "down"  then 
                if  isCursorOnElement(screenW * 0.7573, screenH * 0.7204, screenW * 0.0187, screenH * 0.0287) then
                     selectIMG = true
					 myIMG = 1
	                 setElementData(localPlayer, "TabActive", false)
		             setElementData(localPlayer, "Tab", false)
		             if isElement(myElement) then
                         destroyElement(myElement)
                     end
		            -- exports.object_preview:destroyObjectPreview(myObject)
		             showChat(true)
		             l_0_1 = false
                end
          end
    end
end
addEventHandler("onClientClick",getRootElement(),  selectC)

function MenuModos ( button,state,thePlayer )
    if selectIMG then
          if  state == "down"  then 
                if  isCursorOnElement(screenW * 0.5240, screenH * 0.4509, screenW * 0.0786, screenH * 0.0796) then
                  if myIMG < 5 then
                        myIMG = myIMG + 1 
					end
                end
          end
    end
end
addEventHandler("onClientClick",getRootElement(), MenuModos)

function MenuModos2 ( button,state,thePlayer )
     if selectIMG == true then
       if  state == "down"  then 
            if isCursorOnElement(screenW * 0.3552, screenH * 0.4509, screenW * 0.0786, screenH * 0.0796) then
              if myIMG > 1 then
                 myIMG = myIMG - 1 
              end				 
           end
       end
   end
end
addEventHandler("onClientClick",getRootElement(), MenuModos2)

function selectIMGT ( button,state,thePlayer )
     if selectIMG == true then
       if  state == "down"  then 
            if isCursorOnElement(screenW * 0.4151, screenH * 0.5537, screenW * 0.1266, screenH * 0.0278) then
                 setElementData(localPlayer, "setIMG", myIMG)
				 selectIMG = false			 
           end
       end
   end
end
addEventHandler("onClientClick",getRootElement(), selectIMGT)

local moneyTick = 0


local screenW2, screenH2 = guiGetScreenSize()
local x,y = (screenW2/1360), (screenH2/768)

function convertNumber ( number )  
	local formatted = number  
	while true do      
		formatted, k = string.gsub(formatted, "^(-?%d+)(%d%d%d)", '%1.%2')    
		if ( k==0 ) then      
			break   
		end  
	end  
	return formatted
end

function handleMinimize()
    panelState = false 
end
addEventHandler( "onClientMinimize", root, handleMinimize )

function handleRestore( didClearRenderTargets )
    panelState = true 
	
end
addEventHandler("onClientRestore",root,handleRestore)



